# かわばた日和 環境変数の例。.env.local にコピーして値を入れてください。
# 実際のキーをこのファイルやリポジトリに書かないでください。

# 公開サイトのURL（canonical・OGP・サイトマップに使います）
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase（未設定ならデモモードで動きます）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI文章生成（Claude）。管理画面のAI記事作成・リライト・SEO提案に使います
ANTHROPIC_API_KEY=

# AI画像生成・編集（OpenAI Images API）
OPENAI_API_KEY=
